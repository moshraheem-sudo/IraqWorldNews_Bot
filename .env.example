# توكن البوت الذي حصلت عليه من @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# معرف القناة (مع @ مثل @YourChannel أو الـ Chat ID الرقمي مثل -1001234567890)
TELEGRAM_CHAT_ID=@YourChannelUsername

# الحد الأقصى للمنشورات التي تُرسل في أول تشغيل فقط لمنع إغراق القناة بأخبار قديمة (افتراضي: 3)
FIRST_RUN_MAX_POSTS=3

# تأخير زمني بالثواني بين كل رسالة وأخرى لتفادي قيود تليغرام (Rate Limit)
DELAY_BETWEEN_POSTS=2.0
